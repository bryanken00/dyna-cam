###############################
# APPLICATION
###############################
NODE_ENV=development
PORT=4021
# Display name used in emails; public frontend origin used to build email links
APP_NAME=DGSports
APP_URL=http://localhost:4020

###############################
# DATABASE (REQUIRED)
###############################
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_DATABASE=your_database_name

# Database pool configuration (optional - defaults shown)
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10000

###############################
# FIRST BACK-OFFICE SUPER ADMIN (REQUIRED — read only by `npm run db:setup`)
###############################
# PLAN-008: setup creates ONLY this account — DGSports' own back office (/backoffice).
# Companies and each company's Owner (who signs in to the Admin portal) are onboarded
# there; there is no Owner from setup. Both are required until a super admin exists.
# SUPERADMIN_PASSWORD: 8+ characters and not a well-known weak password. It's your own
# choice, so there's no forced change at first sign-in (super admins added later in the
# back office get a temporary password they must change).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Demo logins made by `npm run db:data` (development only, PLAN-004 — it empties the
# database first, keeping only the permissions and the super admins, then builds two
# demo companies with their Owners and staff). Empty = a random password, printed once.
# 8+ characters, not a well-known weak password.
DEMO_PASSWORD=

###############################
# JWT AUTHENTICATION (REQUIRED)
###############################
jwtAuthPath=./auth-keys
jwtAuthPrivatePath=./auth-keys/private.pem
jwtAuthPublicPath=./auth-keys/public.pem
ISSUER=your-app-name
AUDIENCE=your-app-users

# Token lifetimes (optional - defaults shown). Keep the access token short: the
# client renews it silently. The refresh token is how long an unused session lasts.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Per-account lockout (optional - defaults shown): this many wrong passwords in a
# row lock sign-in for that account for this many minutes.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

###############################
# SECURITY (REQUIRED)
###############################
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=CHANGE_THIS_generate_a_random_64_character_secret_here_do_not_use_this_example_value
LOG_SALT=CHANGE_THIS_generate_a_random_32_character_salt_here_do_not_use_this_example_value

# Signs the links to uploaded files (logos, avatars). Required in production
# (32+ characters; the placeholder below is refused). If unset in development, a
# random secret is used and file links stop working whenever the server restarts.
UPLOAD_URL_SECRET=CHANGE_THIS_generate_a_random_64_character_secret_here_do_not_use_this_example_value
# How long a file link stays valid, in seconds (a link lives 1x to 2x this value)
UPLOAD_URL_TTL_SECONDS=3600

# ── DGSports (PLAN-001; formerly Dyna Cam) ──
# Encrypts the court cameras' RTSP URLs (they carry the camera's password).
# Required in production (32+ characters; the placeholder below is refused).
# Changing it makes every stored camera URL unreadable — re-enter them in Admin.
DEVICE_SECRET_KEY=CHANGE_THIS_generate_a_random_64_character_secret_here_do_not_use_this_example_value
# Recorder boxes enrol with their COMPANY's enroll key (PLAN-008 phase F — no key here any more):
# a super admin makes it in the back office (company page → Box enroll key, shown once), and each
# box's edge/.env gets it as ENROLL_KEY with the venue's VENUE_ID. A key only enrols into that
# company's venues. List / revoke boxes: npm run boxes[:revoke].
# Whole-game videos (CR-006, CR-040): after End game the recorder box makes one file per camera,
# keeps it, and sends it straight to the court's Google Drive — no video ever comes to the API.
# Largest game file the box may send, in MB, and how many hours after a game ends a video the
# box hasn't made yet is given up (one it's already sending to Drive gets until the venue's keep
# time). An old box (no "drive-direct") gets no games: update it within this time.
GAME_VIDEO_MAX_MB=16384
GAME_UPLOAD_GIVE_UP_HOURS=24
# CR-013: saves of "the last N minutes" from the courtside device (made like game videos, one at
# a time — a new save waits its turn). How many a game may hold at once; deleting one frees a slot.
# Staff choose it per game on New game (1–20); this is for games created without it.
CAPTURE_MAX_PER_GAME=5
# CR-028: End game / delete a save / stream taps on a game's page, per IP per minute
RATE_LIMIT_PUBLIC_CONTROL_POINTS=20
# CR-015: "Find a game" lookups by code from the courtside device, per IP per minute
RATE_LIMIT_FIND_GAME_POINTS=10
# CR-040: Google Drive upload progress reports per recorder box per minute
RATE_LIMIT_DEVICE_PROGRESS_POINTS=240

# ── Venue alerts (CR-008) ──
# Every minute the API checks the recorder boxes' heartbeats for problems: a box offline, a
# camera not recording, a box's disk almost full, its clock off, uploads piling up. A problem
# that lasts ALERT_GRACE_MINUTES is sent to staff, and again when it's fixed.
#  • Discord: paste a channel's webhook URL (Server Settings → Integrations → Webhooks). It holds
#    its own token — keep it secret. Empty = no Discord messages.
#  • Email: sent to everyone with the Venue alerts permission once SENDGRID_API_KEY (below) is set.
#    ALERT_EMAIL=false keeps email off even then.
# With neither, problems are only written to the log (and shown on the Dashboard).
ALERTS_ENABLED=true
ALERT_DISCORD_WEBHOOK_URL=
ALERT_DISCORD_USERNAME=DGSports
ALERT_EMAIL=true
ALERT_GRACE_MINUTES=4
# Disk almost full below this % free; clock off beyond this many ms; uploads piling up when the
# oldest unsent clip or game video is older than this many minutes
ALERT_DISK_FREE_PERCENT=10
ALERT_CLOCK_MS=2000
ALERT_BACKLOG_MINUTES=60

# ── Google Drive per court (CR-001) ──
# Staff connect a Google account on a court's setup page; CR-040: the venue's recorder box sends
# every game video and save on that court straight to its Drive, and players get them only there.
# REQUIRED in practice — empty means players get no videos at all. Set up in Google Cloud Console:
#   1. Enable the "Google Drive API".
#   2. OAuth consent screen: External, scopes openid, email and .../auth/drive.file, then
#      PUBLISH it ("In production"). In "Testing", Google drops the sign-in after 7 days.
#   3. Credentials → OAuth client ID → "Web application"; add GOOGLE_REDIRECT_URI below as an
#      authorised redirect URI.
# The redirect URI is this API's /api/v1/oauth/google/callback, as the browser reaches it.
# The stored sign-ins are encrypted with DEVICE_SECRET_KEY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4021/api/v1/oauth/google/callback

# ── Player sign-in with Google (PLAN-006) ──
# Players sign in with Google on the booking pages; booking online NEEDS it — empty means
# players can't book online at all (staff still book at the desk). Same OAuth client as above:
#   1. Google Auth Platform → Data Access: scopes openid, .../auth/userinfo.email,
#      .../auth/userinfo.profile (no Google review needed).
#   2. Clients → the Web client → Authorized redirect URIs: add GOOGLE_LOGIN_REDIRECT_URI below.
# It is this API's /api/v1/auth/google/callback, as the browser reaches it (https, or localhost).
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:4021/api/v1/auth/google/callback

# Optional: API key for public endpoints
SECRET_KEY=

###############################
# ENCRYPTION (OPTIONAL)
###############################
# AES-256 encryption key (if using crypto.js)
cryptoKey=

###############################
# SSL/TLS (OPTIONAL)
###############################
# Path to SSL certificate directory (enables HTTPS)
certPath=

###############################
# CORS (OPTIONAL)
###############################
FRONTEND_URL=http://localhost:4020
ALLOWED_ORIGINS=http://localhost:4020,http://localhost:4021

# Cross-site CSRF cookie mode (set both to true only when the frontend is on a
# different site AND the backend is served over HTTPS)
ALLOW_CROSS_SITE_CSRF=false
COOKIE_SECURE=false
###############################
# REDIS / WORKERS (OPTIONAL)
###############################
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
ENABLE_EMAIL_WORKER=false

###############################
# RATE LIMITING (OPTIONAL)
###############################
# Store type: 'memory' (single instance) | 'redis' (clustered) | 'mysql' (clustered)
# For production with PM2 cluster mode, use 'redis' or 'mysql'
RATE_LIMIT_STORE=memory
RATE_LIMIT_KEY_PREFIX=rl

# Redis-specific (only if RATE_LIMIT_STORE=redis)
RATE_LIMIT_REDIS_HOST=localhost
RATE_LIMIT_REDIS_PORT=6379
RATE_LIMIT_REDIS_PASSWORD=

# Profile overrides (optional - defaults shown)
# API: General requests
RATE_LIMIT_API_POINTS=100
RATE_LIMIT_API_DURATION=900
RATE_LIMIT_API_BLOCK=0

# Auth: Login/Register (stricter)
RATE_LIMIT_AUTH_POINTS=10
RATE_LIMIT_AUTH_DURATION=900
RATE_LIMIT_AUTH_BLOCK=900

# Upload: File uploads
RATE_LIMIT_UPLOAD_POINTS=20
RATE_LIMIT_UPLOAD_DURATION=3600
RATE_LIMIT_UPLOAD_BLOCK=0

# Password Reset (very strict)
RATE_LIMIT_PWRESET_POINTS=3
RATE_LIMIT_PWRESET_DURATION=3600
RATE_LIMIT_PWRESET_BLOCK=3600

# CSRF Token generation
RATE_LIMIT_CSRF_POINTS=30
RATE_LIMIT_CSRF_DURATION=900
RATE_LIMIT_CSRF_BLOCK=0

# Strict: Sensitive operations
RATE_LIMIT_STRICT_POINTS=5
RATE_LIMIT_STRICT_DURATION=3600
RATE_LIMIT_STRICT_BLOCK=7200

###############################
# ONLINE PAYMENT — XENDIT (PLAN-003 Phase F)
###############################
# Players pay court bookings online through DGSports' one Xendit account (GCash, Maya,
# cards… — whatever is enabled on the account). Every venue's money lands in that balance;
# Admin → Payments → Online settlement is the statement to settle with venues from.
# Blank (either one) = online payment off: the booking page offers "Pay at the desk" only.
# Use the TEST-mode keys in development (dashboard.xendit.co, Test mode switch).
#  1. Xendit → Settings → API keys → Generate secret key with Money-in (Write) and
#     Refunds (Write) permission. Paste it here (test keys start with "xnd_development_").
#  2. Xendit → Settings → Webhooks: copy the "Verification token" into XENDIT_CALLBACK_TOKEN,
#     and set the "Invoices paid" and refund webhook URLs to this API's
#     /api/v1/webhooks/xendit (it must be reachable from the internet — in development use a
#     tunnel, or rely on the booking page asking Xendit when the player comes back).
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# PLAN-008: each company connects its OWN Xendit in Admin → Payments → Online payment; the two keys
# above are only the default company's fallback until it saves its own. Each company's webhook URL
# is <API_PUBLIC_URL>/api/v1/webhooks/xendit/<its key> — set the API's public address here
# (e.g. https://api.example.com); empty = the address the request came in on.
API_PUBLIC_URL=
# CR-033: payment sandbox — true = online payment uses a built-in TEST checkout instead of
# Xendit (no keys needed, no real money: "Pay now" opens /payment-sandbox/… with Pay / Go back,
# refunds go through at once). Test checkouts are kept in storage/payment-sandbox.json
# (PAYMENT_SANDBOX_FILE to move it). Takes over from the Xendit keys while on.
# Ignored when NODE_ENV=production. Blank / false = off.
PAYMENT_SANDBOX=false
# Public booking writes per IP per minute: book a slot, open its checkout, cancel / move it
RATE_LIMIT_PUBLIC_BOOK_POINTS=5
RATE_LIMIT_PUBLIC_PAY_POINTS=10
RATE_LIMIT_PUBLIC_CHANGE_POINTS=10
# CR-030: "Find my booking" lookups (booking code + phone or email), per IP per minute
RATE_LIMIT_PUBLIC_FIND_POINTS=5
# PLAN-003 Phase G: the booking reminder email goes out this many minutes before the start
# (sent only with SENDGRID_API_KEY set, like every booking email)
BOOKING_REMINDER_MINUTES=120

###############################
# EMAIL — SENDGRID (CR-018)
###############################
# Every email (password resets, venue alerts, the player's Google Drive link)
# goes through SendGrid's Web API. Blank = nothing is sent: emails are only
# written to the log (fine in development; the Drive-link email waits).
#  1. SendGrid → Settings → API Keys → Create API Key, "Restricted Access" with
#     Mail Send = Full Access. Paste it here (starts with "SG.").
#  2. SendGrid → Settings → Sender Authentication: verify the MAIL_FROM address
#     (Single Sender) or authenticate its domain — SendGrid refuses other senders.
SENDGRID_API_KEY=
MAIL_FROM=DGSports <no-reply@yourdomain.ph>

###############################
# FILE VALIDATION (OPTIONAL)
###############################
STRICT_FILE_VALIDATION=true
SCAN_MALWARE_PATTERNS=true
ALLOW_PRIVATE_IPS=false
EXTERNAL_API_WHITELIST=api.example.com

###############################
# LOGGING (OPTIONAL)
###############################
# Days to keep rotated log files in back/logs (default 90)
LOG_RETENTION_DAYS=90

###############################
# TIMEZONE (OPTIONAL)
###############################
# Display timezone. Storage is Asia/Manila local (see docs/schema-conventions.md).
TIMEZONE=Asia/Manila

DEPLOY_HOST=
REMOTE_DIR_DEV=
PM2_PORT_DEV=
REMOTE_DIR_PROD=
PM2_PORT_PROD=