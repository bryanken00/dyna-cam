# Dyna Cam recorder box — copy to .env and fill in.

# Base URL of the Dyna Cam API (no trailing slash, no /api suffix)
API_URL=https://api.example.com
# The 6-digit key from Admin → Setup → Recorder Boxes → Add box (valid 10 minutes, used once).
# On first start the box pairs with it and keeps its own token in DATA_DIR/device.json;
# after that you can delete this line.
PAIRING_CODE=

# The older way, for boxes set up before pairing keys: the long token copied from the portal.
# Leave empty when you use PAIRING_CODE (a saved device.json wins over both).
DEVICE_TOKEN=

# Where the rolling buffer, job work folders and queue live (relative to edge/)
DATA_DIR=./data
# Length of each buffer segment (seconds). Real length follows the camera's keyframe interval.
SEGMENT_SECONDS=2
# How much video to keep per court (seconds). Must cover 65 s of clip plus job latency.
BUFFER_SECONDS=180
# Clip encoder: auto | libx264 | h264_qsv | h264_vaapi | h264_videotoolbox
ENCODER=auto
# VAAPI render node, only used with h264_vaapi
VAAPI_DEVICE=/dev/dri/renderD128
# Keep camera audio (transcoded to AAC in the buffer). false = video only.
RECORD_AUDIO=true
# Clips cut at the same time (CPU-bound) and uploaded at the same time (network-bound)
CLIP_CONCURRENCY=1
UPLOAD_CONCURRENCY=1
HEARTBEAT_SECONDS=30
CONFIG_REFRESH_SECONDS=60
# debug | info | warn | error
LOG_LEVEL=info
# Override if ffmpeg/ffprobe are not on PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Court buttons (Shelly Button 1 / ESP32) call http://<box-ip>:BUTTON_PORT/press/<code>.
# Leave BUTTON_PORT out for 8089; set it empty or 0 to turn the listener off.
BUTTON_PORT=8089
BUTTON_HOST=0.0.0.0
# Strongly recommended: buttons must then add ?key=<BUTTON_KEY>. Anyone on the venue Wi-Fi
# could otherwise save clips.
BUTTON_KEY=
