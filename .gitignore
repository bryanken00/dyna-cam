# OS junk
.DS_Store
Thumbs.db

# Editors
.idea/
*.swp
*.swo

# Claude Code — skills under .claude/skills/ are checked in on purpose
# (they hold the project's coding conventions). Local machine state is not.
.claude/settings.local.json
.claude/*.local.json

# Pid file of a running ./run.sh / ./run-mac.sh
.run.pid

# Node (safety net — front/ and back/ have their own .gitignore)
node_modules/

# package-lock.json is committed on purpose (front/ and back/): it pins the
# exact dependency versions, and CI installs with `npm ci`, which needs it.

# Local deploy logs written by front/push.sh and back/push.sh (one per deploy)
deploy-logs/
