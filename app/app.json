{
  "expo": {
    "name": "DGSports",
    "slug": "dyna-cam",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "package": "com.dgsi.dynacam",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F3264"
      }
    },
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.dgsi.dynacam",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "DGSports shows the court's live video from the venue's recorder box."
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photo library.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera."
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DGSports uses your location to show the venues and open plays near you."
        }
      ]
    ],
    "scheme": "dgsports"
  }
}
