# Dyna Cam recorder box — copy to .env and fill in.

# Base URL of the Dyna Cam API (no trailing slash, no /api suffix). Must be https:// — the box
# refuses plain http:// except to an API on this same machine (localhost or its own LAN IP, testing).
API_URL=https://api.example.com
# Enrolment (first start only; afterwards the box uses its own token in DATA_DIR/device.json).
# ENROLL_KEY: exactly the API's RECORDER_ENROLL_KEY (back/.env). A password — never logged.
ENROLL_KEY=
# VENUE_ID: Admin portal → Setup → Venues → the venue → Copy ID
VENUE_ID=
# How this box is named in the API (optional; default the hostname)
BOX_NAME=

# Where the rolling buffer, job work folders and queue live (relative to edge/)
DATA_DIR=./data
# Length of each buffer segment (seconds). Real length follows the camera's keyframe interval.
SEGMENT_SECONDS=2
# How much video to keep per court (seconds). Must cover 65 s of clip plus job latency.
BUFFER_SECONDS=180
# Clip encoder: auto | libx264 | h264_qsv | h264_vaapi | h264_videotoolbox
ENCODER=auto
# VAAPI render node, only used with h264_vaapi
VAAPI_DEVICE=/dev/dri/renderD128
# Keep camera audio (transcoded to AAC in the buffer). false = video only.
RECORD_AUDIO=true
# Clips cut at the same time (CPU-bound) and uploaded at the same time (network-bound)
CLIP_CONCURRENCY=1
UPLOAD_CONCURRENCY=1
HEARTBEAT_SECONDS=30
CONFIG_REFRESH_SECONDS=60
# debug | info | warn | error
LOG_LEVEL=info
# Override if ffmpeg/ffprobe are not on PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Live view for session devices on the venue Wi-Fi: http://<box-ip>:LIVE_PORT/live/...
# (signed links from the API only). Leave LIVE_PORT out for 8090; set it empty or 0 to turn it off.
# Open the port on the box firewall (sudo ufw allow 8090/tcp). Devices must be on the same Wi-Fi
# as the box — a guest network with client isolation blocks it.
LIVE_PORT=8090
# The box's LAN address as phones reach it. Empty = detect it (first private IPv4).
LIVE_HOST=
# How far back the session device can rewind the live view (CR-014: "⟲ 10 s"), in seconds. The live
# stream lists this much of the buffer — no extra storage. Kept 30 s inside BUFFER_SECONDS.
LIVE_DVR_SECONDS=60
# Optional HTTPS for the live view: a folder with privkey.pem, cert.pem (+ chain.pem), the same
# files as the API's certPath. LIVE_HOST must then be a host name the certificate covers and that
# resolves to this box's LAN IP. Empty = plain HTTP (the box warns at start-up).
CERT_PATH=

# Stacked live streams (two cameras, Cam 1 over Cam 2, re-encoded) at once, court and player
# streams together. Each takes about a CPU core with libx264 (less with VAAPI/QSV). 0 = never stack.
MAX_STACKED_STREAMS=2
