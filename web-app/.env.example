# PLAN-009: the DGSports player app. /api/v1 and /public/uploads are proxied to the API
# in development (vite.config.js) and by the web server in production.
VITE_API_URL=http://localhost:4021
# The main DGSports web app (front/) — a game's page, clips and streams stay there.
# Empty = the same origin (both apps behind one domain).
VITE_MAIN_APP_URL=http://localhost:4020
VITE_APP_NAME=DGSports
# Short, unique slug — prefixes every browser-storage key (e.g. dgsports-play-player).
# Changing it signs everyone out once.
VITE_STORE_KEY=dgsports-play
VITE_APP_ENV=development
VITE_SENTRY_DSN=
