{
  "name": "dyna-cam-api",
  "version": "1.0.0",
  "description": "Dyna Cam API",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./server/bin/www.js",
    "dev": "nodemon ./server/bin/www.js",
    "pm2:start": "sudo pm2 start ecosystem.config.cjs",
    "pm2:prod": "sudo pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "sudo pm2 reload ecosystem.config.cjs",
    "pm2:stop": "sudo pm2 stop ecosystem.config.cjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint \"server/**/*.{js,jsx}\" \"tests/**/*.js\"",
    "lint:fix": "eslint \"server/**/*.{js,jsx}\" \"tests/**/*.js\" --fix",
    "format": "prettier --write \"server/**/*.js\"",
    "format:check": "prettier --check \"server/**/*.js\"",
    "db:setup": "node scripts/setup-database.js",
    "db:setup:clean": "node scripts/setup-database-clean.js",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/reset-database.js",
    "db:check": "node scripts/check-database.js",
    "boxes": "node scripts/boxes.js",
    "boxes:revoke": "node scripts/boxes.js revoke",
    "keys": "node scripts/generate-keys.js"
  },
  "author": "Alfie Garing",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.5",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "rate-limiter-flexible": "^11.2.3",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
